<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>1.2.7-pre.2</Version>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\Mods\mod</OutputPath>
    <VintageStoryPath Condition="'$(VintageStoryPath)' == '' and '$(VINTAGE_STORY)' != ''">$(VINTAGE_STORY)</VintageStoryPath>
    <VintageStoryPath Condition="'$(VintageStoryPath)' == ''">E:\vintagestory\Vintagestory</VintageStoryPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="YellowDogMan.RRNoise.NET" Version="0.1.9" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <Compile Remove="Tools\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VintageStoryPath)\VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VintagestoryLib">
      <HintPath>$(VintageStoryPath)\VintagestoryLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OpenTK.Audio.OpenAL">
      <HintPath>$(VintageStoryPath)\Lib\OpenTK.Audio.OpenAL.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OpenTK.Mathematics">
      <HintPath>$(VintageStoryPath)\Lib\OpenTK.Mathematics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(VintageStoryPath)\Lib\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="cairo-sharp">
      <HintPath>$(VintageStoryPath)\Lib\cairo-sharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="protobuf-net">
      <HintPath>$(VintageStoryPath)\Lib\protobuf-net.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="modinfo.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="modicon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="THIRD-PARTY-NOTICES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="docs\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="RemoveWhisperNativeRuntimeFromPackage" AfterTargets="Build">
    <Delete Files="$(TargetDir)ggml-metal.metal" />
    <ItemGroup>
      <WhisperRuntimeFiles Include="$(TargetDir)runtimes\**\*whisper*" />
      <WhisperRuntimeFiles Include="$(TargetDir)runtimes\**\*ggml*" />
    </ItemGroup>
    <Delete Files="@(WhisperRuntimeFiles)" />
  </Target>

  <Target Name="StageRnnoiseNativeRuntime" AfterTargets="RemoveWhisperNativeRuntimeFromPackage">
    <MakeDir Directories="$(TargetDir)native\runtimes\win-x64;$(TargetDir)native\runtimes\win-x86;$(TargetDir)native\runtimes\linux-x64;$(TargetDir)native\runtimes\linux-arm64" />
    <Copy SourceFiles="$(TargetDir)runtimes\win-x64\native\rnnoise.dll" DestinationFiles="$(TargetDir)native\runtimes\win-x64\rnnoise.dll" Condition="Exists('$(TargetDir)runtimes\win-x64\native\rnnoise.dll')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)runtimes\win-x86\native\rnnoise.dll" DestinationFiles="$(TargetDir)native\runtimes\win-x86\rnnoise.dll" Condition="Exists('$(TargetDir)runtimes\win-x86\native\rnnoise.dll')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)runtimes\linux-x64\native\librnnoise.so" DestinationFiles="$(TargetDir)native\runtimes\linux-x64\librnnoise.so" Condition="Exists('$(TargetDir)runtimes\linux-x64\native\librnnoise.so')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)runtimes\linux-arm64\native\librnnoise.so" DestinationFiles="$(TargetDir)native\runtimes\linux-arm64\librnnoise.so" Condition="Exists('$(TargetDir)runtimes\linux-arm64\native\librnnoise.so')" SkipUnchangedFiles="true" />
    <Delete Files="$(TargetDir)runtimes\win-x64\native\rnnoise.dll;$(TargetDir)runtimes\win-x86\native\rnnoise.dll;$(TargetDir)runtimes\linux-x64\native\librnnoise.so;$(TargetDir)runtimes\linux-arm64\native\librnnoise.so" />
    <RemoveDir Directories="$(TargetDir)runtimes\win-x64\native;$(TargetDir)runtimes\win-x86\native;$(TargetDir)runtimes\linux-x64\native;$(TargetDir)runtimes\linux-arm64\native" Condition="Exists('$(TargetDir)runtimes')" />
    <RemoveDir Directories="$(TargetDir)runtimes\win-x64;$(TargetDir)runtimes\win-x86;$(TargetDir)runtimes\linux-x64;$(TargetDir)runtimes\linux-arm64" Condition="Exists('$(TargetDir)runtimes')" />
    <RemoveDir Directories="$(TargetDir)runtimes" Condition="Exists('$(TargetDir)runtimes')" />
  </Target>

</Project>
